# Flask
# Debug mode is never enabled anywhere in this app (Flask's FLASK_ENV/FLASK_DEBUG
# have no effect here — gunicorn loads wsgi:app directly, bypassing `flask run`
# entirely, and app.run()'s own dev-server debug flag is never set either).
FLASK_SECRET_KEY=change-me-to-a-random-value
PORT=8000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cheaper model the audit (scripts/audit_store.py) uses for its
# high-volume extraction/classification calls — the main model above is
# only used for the audit's single final contradiction-confirmation check.
AUDIT_FAST_MODEL=claude-haiku-4-5-20251001

# Shopify Admin GraphQL API
# Latest stable version as of 2026-09-28 (check https://shopify.dev/docs/api/admin-graphql
# for the current one periodically — format: YYYY-MM, new stable roughly every 3 months).
SHOPIFY_API_VERSION=2026-07

# Storage
DATABASE_PATH=instance/app.db
STORES_DIR=stores

# Outbound HTTP (Shopify, Anthropic, scraping) IP family preference —
# see app/net.py. "prefer-ipv4" (default) sorts resolved IPv4 addresses
# before IPv6 ones for every outbound request, without disabling IPv6
# outright. Set to "ipv4-only" if a host's IPv6 "route" is actually a dead
# end that still breaks things even with prefer-ipv4 (rare); "system" to
# disable this entirely and use the OS's own resolution order. Needed
# because some VPS hosts resolve Shopify's domain to both an IPv4 and
# IPv6 address but have no real IPv6 route, which can make a request fail
# outright instead of quietly falling back to IPv4.
OUTBOUND_IP_FAMILY=prefer-ipv4

# UID/GID the app container runs as (Dockerfile, docker-entrypoint.sh) —
# matched to your deploy user so files the app writes into the bind-mounted
# instance/, stores/, data/ directories are owned by THAT user on the host,
# not root. Defaults to 1000, the usual first non-root user on a fresh
# Ubuntu/Debian install. If your deploy user has different IDs, check with
# (while logged in as that user): `id -u` / `id -g`
APP_UID=1000
APP_GID=1000

# Deployment behind a reverse proxy (e.g. Caddy). Number of trusted proxy
# hops — 0 (default) means "not behind a proxy", X-Forwarded-* headers are
# ignored. Set to 1 for a single Caddy instance in front of this app; only
# set this when you control the proxy and know it always sets these headers
# (otherwise a client could spoof request.scheme/host by sending them itself).
TRUSTED_PROXY_COUNT=0

# Demo links (scripts/create_demo.py) stop working after this many days.
DEMO_EXPIRY_DAYS=30

# Audit report links (scripts/audit_store.py) stop working after this many days.
AUDIT_EXPIRY_DAYS=60

# A conversation (and its messages/tool calls/handoffs) older than this is
# deleted by scripts/purge_old_conversations.py — run daily from cron.
CONVERSATION_RETENTION_DAYS=90

# Shared secret scripts/test_demo.py sends as the X-Tillbird-Internal-Test
# header on /api/chat so its own testing traffic doesn't count against a
# demo's public DEMO_MESSAGE_CAP_DAILY/TOTAL (app/routes/chat.py) — a real
# prospect must never see "usage limit reached" because of your own
# testing. Leave blank to disable (test_demo.py still works either way,
# just subject to the normal public caps). Generate any random string,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(24))"`.
INTERNAL_TEST_TOKEN=

# Tillbird's own privacy page, linked from the widget's small disclosure
# line — distinct from a store's own privacy_policy_url (that's theirs).
TILLBIRD_PRIVACY_URL=https://tillbird.co.uk/privacy

# This server's own public URL (no trailing slash) — set this in production
# so scripts/create_demo.py prints a real, shareable demo link instead of
# localhost. Leave blank in local dev.
PUBLIC_BASE_URL=

# Per-store Shopify Admin API credentials.
# Since Jan 2026, new Shopify apps are created in the Dev Dashboard
# (https://dev.shopify.com/dashboard/) and authenticate via the client
# credentials grant — no more permanent shpat_ tokens from the Shopify
# admin. The app fetches and auto-refreshes tokens itself (they expire
# every 24h); see app/shopify_client.py and scripts/get_shopify_token.py.
#
# Each store's stores/<store_id>.yaml names the env vars that hold its
# credentials via `client_id_env` / `client_secret_env`. Add one pair per
# LIVE store here, e.g.:
# SHOPIFY_CLIENT_ID_EMBERHOME=
# SHOPIFY_CLIENT_SECRET_EMBERHOME=
#
# Legacy path (pre-2026 custom apps with a permanent token already issued):
# a store can instead set `admin_token_env` and you add e.g.:
# SHOPIFY_ADMIN_TOKEN_DEMO_EXAMPLE=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OAuth install flow for actual clients (their store is in its own,
# separate Shopify organization — the above client-credentials grant only
# works within your own org). A custom-distribution app only installs on
# the ONE store/org it was generated for, so there's a SEPARATE Dev
# Dashboard app per client, not one shared app — each client's own
# client_id/secret are registered with a provisioning script (stored
# encrypted in the database, app.models.ShopifyAppCredential), not here.
# Scopes ARE the same across every client
# app (set identically in each app's Configuration), so that one stays a
# single value here.
SHOPIFY_OAUTH_SCOPES=read_orders,read_products
OAUTH_STATE_EXPIRY_MINUTES=10

# Fernet key encrypting OAuth tokens AND each client's app secret at rest
# (app/credential_encryption.py, app.models.ShopifyOAuthCredential /
# ShopifyAppCredential) — the single most sensitive secret in the system
# once any client is live. Generate ONCE, INSIDE the container (the host
# has no Python environment with `cryptography` installed):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml exec -T app \
#     python -c "from app.credential_encryption import generate_key; print(generate_key())"
# Store it the same careful way as FLASK_SECRET_KEY — never printed, never
# committed, never logged — and never rotate it without first decrypting
# every existing row under the old key and re-encrypting under the new one.
CREDENTIAL_ENCRYPTION_KEY=

# Pre-flight cost cap for the automatic knowledge-base draft run right
# after a client installs (app/live_onboarding.py) — the install itself
# always succeeds even if this is exceeded; only the draft is skipped.
LIVE_ONBOARDING_MAX_COST=1.00

# SMTP, for handoff emails. Optional: if SMTP_HOST/SMTP_FROM are left blank,
# handoffs still work — they're logged (app/agent/handoff.py) and the
# customer still gets a confirmation, just no email actually sends.
# Port 465 uses implicit TLS (SMTP_SSL); any other port uses STARTTLS.
# Test your setup with: python scripts/test_smtp.py you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Where "get a free demo" form submissions (site/index.html -> POST
# /api/lead) get emailed. The lead is always stored in the DB either way —
# see scripts/list_leads.py. Defaults to lev@tillbird.co.uk if unset.
LEAD_NOTIFY_EMAIL=

# Where monthly-usage threshold alerts (80%/100% of a client's plan) and
# trial-ended notices get emailed — always me, never the shop owner.
# Defaults to lev@tillbird.co.uk if unset; blank disables both (best-effort
# no-op either way, same as SMTP_HOST unset).
ALERT_EMAIL=

# Extra CORS origins allowed on every store's chat/lead endpoints, on top of
# each store's own allowed_origins — for testing site/ locally against a
# real running app server (e.g. `python3 -m http.server 9000` in site/)
# without editing any store's YAML. Comma-separated. LEAVE BLANK IN
# PRODUCTION — only meant for local dev.
DEV_EXTRA_ORIGINS=
